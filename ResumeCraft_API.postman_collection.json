    {
      "name": "Notifications",
      "description": "Firebase push notifications dispatch endpoint.",
      "item": [
        {
          "name": "Send Push Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firebaseUid\": \"{{firebaseUid}}\",\n  \"title\": \"Resume Review Complete\",\n  \"body\": \"Your resume suggestions are ready for review.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "send"]
            },
            "description": "Sends a Firebase push notification via Firebase Admin Messaging targeting a user's topic (firebaseUid)."
          }
        }
      ]
