              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resume\": \"{{resumeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/share",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share"]
            },
            "description": "Generates a unique shareId and creates a public share record for the owned resume."
          }
        },
        {
          "name": "Get Shared Resume",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/share/{{shareId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "share", "{{shareId}}"]
            },
            "description": "Public endpoint to view a shared resume by its unique shareId."
          }
        }
      ]
    },
